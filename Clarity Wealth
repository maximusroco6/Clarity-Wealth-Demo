function requestImpact(){const form=$('request-form');if(!form)return null;const ticker=$('req-ticker').value.trim().toUpperCase(),type=$('req-type').value,amount=Number($('req-amount').value),existing=Number($('req-existing').value),source=$('req-source').value,portfolio=number('Client Requests','B13'),holdings=Object.fromEntries(Array.from({length:6},(_,i)=>[String(value('Client Requests','D'+(14+i))),number('Client Requests','E'+(14+i))]));const total=portfolio+(source==='New money'?amount:0),concentration=total>0?(amount+existing)/total:0;let issues=[];if(!ticker)issues.push('Enter an investment name or ticker.');if(!Number.isFinite(amount)||amount<=0)issues.push('Enter an amount above zero.');if(!Number.isFinite(existing)||existing<0||existing>portfolio)issues.push('Current holding must be between zero and the portfolio size.');if(portfolio<=0)issues.push('Set a positive portfolio size in the workbook request inputs.');if(source!=='New money'&&amount>(holdings[source]??0))issues.push('The requested amount exceeds the selected funding holding. Choose another source or reduce the amount.');if(!Number.isFinite(concentration)||concentration>1)issues.push('The requested position exceeds the resulting portfolio.');if(ticker===source.toUpperCase())issues.push('Choose a funding holding different from the requested investment.');let flags=[];const limit=parseFloat(String(value('Client Preferences','C4')).match(/\d+(?:\.\d+)?/)?.[0]||'10')/100;if(type==='Individual Stock'&&String(value('Client Preferences','B4')).toLowerCase()==='no')flags.push('Individual stocks conflict with the stated preference.');if(type==='Individual Stock'&&concentration>limit)flags.push('Position exceeds the client’s stated individual-stock limit. Other stocks would also count toward a total sleeve limit.');if(type==='Crypto'&&String(value('Client Preferences','B9')).toLowerCase()==='no')flags.push('Crypto conflicts with the stated preference.');const reserve=parseFloat(String(value('Client Preferences','C5')).replace(/[^0-9.]/g,''))||0;if(source==='Cash / Treasury'&&(holdings[source]-amount)<reserve)flags.push('Funding would fall below the stated minimum cash reserve.');if(concentration>.1)flags.push('High concentration: over 10% of the portfolio.');else if(concentration>.05)flags.push('Watch concentration: over 5% of the portfolio.');return {ticker,type,amount,existing,source,portfolio,total,concentration,issues,flags,beforeSource:holdings[source]??0,afterSource:source==='New money'?0:(holdings[source]??0)-amount};}
function requestPreview(){const r=requestImpact();if(!r)return;$('request-preview').innerHTML=`<p>Portfolio: <b>${money(r.portfolio)}</b> → <b>${money(r.total)}</b><br>Requested holding: <b>${money(r.existing)}</b> → <b>${money(r.existing+r.amount)}</b> (${percent(r.concentration)})${r.source==='New money'?'<br>New capital is added to the portfolio.':`<br>${escapeHTML(r.source)}: ${money(r.beforeSource)} → ${money(r.afterSource)}`}</p>${r.issues.length?`<div class="warning error">${r.issues.map(escapeHTML).join('<br>')}</div>`:''}${r.flags.length?`<div class="warning">${r.flags.map(escapeHTML).join('<br>')}</div>`:''}`;}
function messageCard(m){return `<div class="message"><span class="status">${escapeHTML(m.status)}</span><h2>${escapeHTML(m.title)}</h2><small>${escapeHTML(new Date(m.date).toLocaleString())}</small><p>${escapeHTML(m.text)}</p>${m.impact?`<p><b>Portfolio at submission:</b> ${money(m.impact.portfolio)} → ${money(m.impact.total)}<br><b>Proposed position:</b> ${percent(m.impact.concentration)} · ${escapeHTML(m.impact.source)} funding</p>${m.impact.flags.length?`<p class="warning">${m.impact.flags.map(escapeHTML).join('<br>')}</p>`:''}`:''}${m.review?`<p><b>Recorded review:</b> ${escapeHTML(m.review)}</p>`:''}<label>Review notes / recommendation<textarea id="review-${m.id}" maxlength="2000">${escapeHTML(m.review||'')}</textarea></label><div class="actions"><button data-action="review" data-id="${m.id}">Save discussion / modify</button><button data-action="understand" data-id="${m.id}">I understand</button><button data-action="hold" data-id="${m.id}">Do not proceed</button><button data-action="record" data-id="${m.id}">Add to decision history</button></div><small>Demo review only. Status changes do not approve or execute an investment.</small></div>`}
function submit(kind){if(kind==='message'){const text=$('message-text').value.trim();if(!text)return;state.messages.unshift({id:String(Date.now()),date:new Date().toISOString(),title:$('message-topic').value,text,status:'Pending advisor review'});}else if(kind==='request'){const r=requestImpact(),reason=$('req-reason').value.trim();if(!r||r.issues.length||!reason)return;state.messages.unshift({id:String(Date.now()),date:new Date().toISOString(),title:r.ticker+' · '+r.type,text:reason,status:'Pending advisor review',impact:r});if(r.source!=='New money'){const s='Client Requests';book.set(s,'B6',r.ticker);book.set(s,'C6',r.type);book.set(s,'D6',r.amount);book.set(s,'F6',reason);book.set(s,'G6',r.source);book.set(s,'H6',r.existing);book.set(s,'L6','Pending');}}save();draw();}
function action(type,id){if(type==='print'){window.print();return}const m=state.messages.find(m=>m.id===id);if(!m)return;const notes=$('review-'+id)?.value.trim()||'';if(type==='review'){m.review=notes;m.status='Discuss / Modify'}if(type==='understand'){m.review=notes;m.status='I understand'}if(type==='hold'){m.review=notes;m.status='Do not proceed'}if(type==='record'){if(state.decisions.some(d=>d.messageId===m.id)){m.status='Recorded in decision history'}else state.decisions.unshift({id:String(Date.now()),messageId:m.id,date:new Date().toISOString(),decision:m.title,reason:m.text,recommendation:notes||m.review||'Review not yet documented',choice:m.status,expected:m.impact?'Proposed concentration '+percent(m.impact.concentration):'Clarify the question before acting',reviewDate:'Next portfolio review',reviewNotes:''});}save();draw();}
function recordsPanel(){return `<article class="report"><h2>Your current demo summary</h2><p><b>${escapeHTML(value('New Client','B5'))}</b> · ${escapeHTML(value('New Client','G12'))} · ${money(number('New Client','B7'))} investable assets</p><p>Cash-flow example surplus: ${money(number('Cash Flow','B21'))} per month.<br>Retirement example: ${escapeHTML(value('Retirement Plan','G12'))} · ${percent(number('Retirement Plan','G9'))} initial withdrawal rate.<br>Family planning: ${state.family?'enabled':'disabled'}.</p><div class="actions"><button data-action="print">Print / save report as PDF</button><button data-goto="ideas">View questions & requests</button></div><p class="note">These summaries describe the separate workbook examples. They do not combine them into one verified financial plan.</p></article><article><h2>Decision history</h2>${state.decisions.length?state.decisions.map(d=>`<div class="message"><h2>${escapeHTML(d.decision)}</h2><small>${escapeHTML(new Date(d.date).toLocaleDateString())}</small><p><b>Client reason:</b> ${escapeHTML(d.reason)}<br><b>Recorded recommendation:</b> ${escapeHTML(d.recommendation)}<br><b>Client response:</b> ${escapeHTML(d.choice)}<br><b>Expected impact:</b> ${escapeHTML(d.expected)}</p><label>When to review<input data-decision="${d.id}" data-property="reviewDate" value="${escapeHTML(d.reviewDate)}"></label><label>Review notes<textarea data-decision="${d.id}" data-property="reviewNotes">${escapeHTML(d.reviewNotes)}</textarea></label></div>`).join(''):'<p>Use “Add to decision history” on a saved message or investment idea to record the reasoning.</p>'}<p class="note">The original workbook’s Decision Memory example remains available below.</p></article>`}
const originalDraw=draw;draw=function(){originalDraw();document.querySelectorAll('[data-decision]').forEach(e=>e.onchange=()=>{const d=state.decisions.find(x=>x.id===e.dataset.decision);if(d){d[e.dataset.property]=e.value;save()}})};
$('family-enabled').onchange=e=>familyMode(e.target.checked);$('reset').onclick=()=>$('confirm-reset').showModal();$('cancel-reset').onclick=()=>$('confirm-reset').close();$('do-reset').onclick=()=>{book.reset();state={family:false,messages:[],decisions:[],familyValues:{}};active='home';sheet='';$('confirm-reset').close();familyMode(false);};
$('download-plan').onclick=()=>{const clone=document.documentElement.cloneNode(true);clone.querySelector('#saved-demo')?.remove();const html='<!doctype html>\n'+clone.outerHTML.replace('</head>','<script id="saved-demo" type="application/json">'+JSON.stringify({version:3,values:book.values,state}).replaceAll('<','\\u003c')+'<\/script></head>');const blob=new Blob([html],{type:'text/html'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='Clarity_Wealth_My_Demo.html';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);};
const embedded=$('saved-demo');if(embedded){try{const parsed=JSON.parse(embedded.textContent);if(parsed.version===3){book.values=parsed.values;state={...state,...parsed.state}}}catch{}}
if(!state.family)familyMode(false);else draw();
function sheetChecks(s){const warnings=[];if(s==='Client Requests'){const amount=number(s,'D6'),source=String(value(s,'G6')),rows=Array.from({length:6},(_,i)=>i+14),r=rows.find(r=>String(value(s,'D'+r))===source);if(!r)warnings.push('Select a funding holding from the portfolio. The original worksheet does not model new-money funding.');else if(amount>number(s,'E'+r))warnings.push('Requested amount exceeds the selected funding holding. This proposal is not fully funded.');if(Math.abs(number(s,'G21')-number(s,'B13'))>.01)warnings.push('The modeled after-change holdings do not match the portfolio total. Review the funding assumptions.');}if(s==='Retirement Plan'&&number(s,'B6')<number(s,'B5'))warnings.push('Retirement age must be at least the current age. Update the inputs before using the results.');if(s==='Retirement What-If'&&['B4','C4'].some(a=>number(s,a)<53))warnings.push('This workbook comparison uses a fixed current age of 53. Use retirement ages of 53 or above.');if(s==='What-If Simulator'&&['B','C'].some(c=>number(s,c+'14')<0))warnings.push('Gifts and debt payoff exceed the starting balance. The scenario is not funded.');if(s==='Portfolio Allocations')warnings.push('These sample-client allocations are entered portfolio examples. Changing a client risk score does not automatically replace these allocations. The New Client tool has automatic risk-based allocations.');if(s==='Fees & Costs')warnings.push('Fee rates are workbook examples, not verified current product or advisory fees.');return warnings.map(w=>`<div class="warning">${escapeHTML(w)}</div>`).join('');}

function enhanceTables(){
 document.querySelectorAll('.sheet-table').forEach((table,tableIndex)=>{
  let headers=[];
  [...table.rows].forEach((row,rowIndex)=>{
   const cells=[...row.cells];
   if(cells.length===1&&cells[0].colSpan>1){row.classList.add('mobile-narrative');return}
   const isHeader=cells.some(c=>c.tagName==='TH');
   if(isHeader){headers=cells.map(c=>c.textContent.trim());row.classList.add('mobile-table-header');return}
   row.classList.add('mobile-record');
   cells.forEach((cell,i)=>{
    if(!cell.textContent.trim()&&!cell.querySelector('input,select,textarea')){cell.classList.add('mobile-empty');return}
    cell.dataset.mobileLabel=headers[i]||(i===0?'':i===1?'Value':'Details');
    if(i===0)cell.classList.add('mobile-record-title');
    else if(!cell.querySelector('input,select,textarea')&&(i>2||cell.textContent.trim().length>120))cell.classList.add('mobile-secondary');
   });
   if(cells.some(c=>c.classList.contains('mobile-secondary'))){
    const td=document.createElement('td');td.className='mobile-detail-action';td.colSpan=cells.length;
    const button=document.createElement('button');button.type='button';button.textContent='Show details';button.setAttribute('aria-expanded','false');button.onclick=()=>{const open=row.classList.toggle('mobile-details-open');button.textContent=open?'Hide details':'Show details';button.setAttribute('aria-expanded',String(open))};td.append(button);row.append(td);
   }
  });
 });
}
function closeMenu(){document.querySelector('aside').classList.remove('menu-open');$('menu-toggle').setAttribute('aria-expanded','false');$('menu-toggle').textContent='Menu';}
$('menu-toggle').onclick=()=>{const open=document.querySelector('aside').classList.toggle('menu-open');$('menu-toggle').setAttribute('aria-expanded',String(open));$('menu-toggle').textContent=open?'Close menu':'Menu';};
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeMenu();$('menu-toggle').focus();}});
window.matchMedia('(max-width: 760px)').addEventListener('change',closeMenu);
</script></body></html>
