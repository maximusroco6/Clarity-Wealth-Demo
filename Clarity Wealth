function colNumber(c){return [...c].reduce((n,x)=>n*26+x.charCodeAt(0)-64,0)}function colName(n){let s='';while(n){n--;s=String.fromCharCode(65+n%26)+s;n=Math.floor(n/26)}return s}
function optionList(s,a){const row=+a.match(/\d+/)[0],col=colNumber(a.match(/[A-Z]+/)[0]);for(const d of s.validations){for(const r of d.range.split(' ')){const parts=r.split(':'),start=parts[0].replaceAll('$',''),end=(parts[1]||parts[0]).replaceAll('$','');if(row>=+start.match(/\d+/)[0]&&row<=+end.match(/\d+/)[0]&&col>=colNumber(start.match(/[A-Z]+/)[0])&&col<=colNumber(end.match(/[A-Z]+/)[0])&&d.type==='list'&&d.formula?.startsWith('"'))return d.formula.slice(1,-1).split(',')}}return null;}
const manualInputs={'Before I Say Yes':['B14','B15','B16','B17'], 'Client Requests':['B33'], 'Decision Memory':Array.from({length:8},(_,i)=>colName(i+1)+'6')};
function hiddenRow(s,r){if(state.family)return false;return s==='Client Intake'&&r>=8&&r<=11||s==='Cash Flow'&&r===12||s==='Risk Capacity'&&r===10||s==='Financial Copilot'&&r===8||s==='Goal Priority'&&r>=4&&r<=6;}
function inputHTML(s,a,c){const v=value(s.name,a),opts=optionList(s,a),inputData=escapeHTML(JSON.stringify([s.name,a]));const label=escapeHTML(`${s.name}: ${s.cells['A'+a.match(/\d+/)[0]]?.v||a}`);if(opts)return `<select aria-label="${label}" data-input="${inputData}">${opts.map(o=>`<option ${String(v)===o?'selected':''}>${escapeHTML(o)}</option>`).join('')}</select>`;if(typeof c.v==='number'||typeof v==='number'){const percentage=c.format.includes('%');return `<input aria-label="${label}${percentage?' (decimal rate, e.g. 0.07 = 7%)':''}" type="number" step="any" ${percentage?'min="-0.99" max="1"':'min="0" max="1000000000"'} data-input="${inputData}" value="${escapeHTML(v)}">${percentage?'<small class="note">Decimal rate (0.07 = 7%)</small>':''}`;}if(String(v).length>65||['Client Requests','Decision Memory'].includes(s.name)&&['F','G','H'].includes(a[0]))return `<textarea aria-label="${label}" maxlength="2000" data-input="${inputData}">${escapeHTML(v)}</textarea>`;return `<input aria-label="${label}" maxlength="300" data-input="${inputData}" value="${escapeHTML(v)}">`;}
function sheetView(name){const s=WORKBOOK.find(x=>x.name===name);if(!s)return '';const byRow={};for(const[a,c]of Object.entries(s.cells)){const r=+a.match(/\d+/)[0];if(hiddenRow(name,r))continue;(byRow[r]??=[]).push([a,c]);}let chunks=[],group=[];let previous=0;for(const r of Object.keys(byRow).map(Number).sort((a,b)=>a-b)){const cells=byRow[r];if(r===1)continue;if(r>previous+1&&group.length){chunks.push(group);group=[]}group.push([r,cells]);previous=r;}if(group.length)chunks.push(group);let html=`<h2 class="sheet-title">${escapeHTML(value(name,'A1'))}</h2>`;if(['New Client','Client Intake','Retirement Plan','Jay - Two Goals'].includes(name))html+='<p class="module-description">This is the workbook’s sample, with its own inputs. Changing one example does not overwrite the other examples.</p>';for(const chunk of chunks){const maxCol=Math.max(...chunk.flatMap(([,cells])=>cells.map(([a])=>colNumber(a.match(/[A-Z]+/)[0]))));const onlyText=chunk.every(([,cells])=>cells.every(([a,c])=>!c.input&&!(manualInputs[name]||[]).includes(a)&&!(typeof c.v==='string'&&c.v.startsWith('='))&&typeof c.v!=='number'))&&maxCol<=2;if(onlyText){html+=`<article class="sheet-card">${chunk.flatMap(([,cells])=>cells).map(([a])=>`<p class="narrative">${escapeHTML(value(name,a))}</p>`).join('')}</article>`;continue;}const allCols=new Set(chunk.flatMap(([,cells])=>cells.filter(([,c])=>c.v!=null||c.input).map(([a])=>colNumber(a.match(/[A-Z]+/)[0]))));let segments=[],segment=[];for(const col of [...allCols].sort((a,b)=>a-b)){if(segment.length&&col>segment.at(-1)+1){segments.push(segment);segment=[]}segment.push(col)}if(segment.length)segments.push(segment);for(const cols of segments){const rows=chunk.filter(([,cells])=>cells.some(([a])=>cols.includes(colNumber(a.match(/[A-Z]+/)[0]))));if(!rows.length)continue;html+='<article class="sheet-card"><div class="table-wrap"><table class="sheet-table"><tbody>';for(const[r,cells]of rows){const populated=cells.filter(([a,c])=>cols.includes(colNumber(a.match(/[A-Z]+/)[0]))&&(c.v!=null||c.input));if(populated.length===1&&!populated[0][1].input&&!(manualInputs[name]||[]).includes(populated[0][0])){const[a,c]=populated[0];html+=`<tr><td colspan="${cols.length}"><span class="sheet-text">${escapeHTML(fmt(value(name,a),c.format))}</span></td></tr>`;continue;}html+='<tr>';for(const col of cols){const a=colName(col)+r,c=s.cells[a];if(!c){html+='<td></td>';continue;}let editable=c.input||(manualInputs[name]||[]).includes(a);if(!state.family&&name==='What-If Simulator'&&['B9','C9'].includes(a))editable=false;const header=c.fill==='FF244A73'||c.fill==='FF17365D'||c.fill==='FF1F4E78';const tag=header?'th':'td';const calc=typeof c.v==='string'&&c.v.startsWith('=');let v=value(name,a);if(!state.family&&name==='What-If Simulator'&&a==='A9')v='Family gift (disabled)';html+=`<${tag} class="${calc?'calc':col===cols[0]?'label-cell':''}">${editable?inputHTML(s,a,c):String(v).startsWith('https://')?`<a href="${escapeHTML(v)}" target="_blank" rel="noopener noreferrer">Official source</a>`:`<span class="sheet-text">${escapeHTML(fmt(v,c.format))}</span>`}</${tag}>`;}html+='</tr>';}html+='</tbody></table></div></article>';}}return html;}
function chart(title,names,series,labels,note=''){
 const finite=series.flat().filter(Number.isFinite),max=Math.max(1,...finite),min=Math.min(0,...finite),range=max-min,colors=['#2176a5','#159984','#be8644','#755ab0'];
 function plot(mobile){const width=mobile?360:800,left=mobile?65:100,right=mobile?345:780,top=25,bottom=230;const compact=v=>Math.abs(v)>=1e6?'$'+(v/1e6).toFixed(1)+'m':Math.abs(v)>=1000?'$'+Math.round(v/1000)+'k':money(v);return `<svg class="${mobile?'chart-mobile':'chart-desktop'}" viewBox="0 0 ${width} 280" role="img" aria-label="${escapeHTML(title)}"><title>${escapeHTML(title)}</title>${[0,.5,1].map(t=>`<line x1="${left}" y1="${bottom-t*(bottom-top)}" x2="${right}" y2="${bottom-t*(bottom-top)}" stroke="#dbe4ef"/><text x="3" y="${bottom+5-t*(bottom-top)}" fill="#52677d" font-size="${mobile?14:13}">${mobile?compact(min+range*t):money(min+range*t)}</text>`).join('')}${series.map((s,i)=>`<polyline points="${s.map((v,j)=>`${left+j/Math.max(1,s.length-1)*(right-left)},${bottom-(v-min)/range*(bottom-top)}`).join(' ')}" stroke="${colors[i%colors.length]}" stroke-width="3" fill="none"/>`).join('')}${labels.map((l,i)=>i===0||i===labels.length-1||i===Math.floor(labels.length/2)?`<text x="${left+i/Math.max(1,labels.length-1)*(right-left)}" y="263" text-anchor="${i===0?'start':i===labels.length-1?'end':'middle'}" fill="#52677d" font-size="${mobile?14:13}">${escapeHTML(mobile?String(l).split(' ')[0]:l)}</text>`:'').join('')}</svg>`}
 return `<div class="chart-panel"><h2>${escapeHTML(title)}</h2><p class="muted">${escapeHTML(note)}</p>${plot(false)}${plot(true)}<div class="chart-legend">${names.map((n,i)=>`<div><span style="color:${colors[i%colors.length]}">● ${escapeHTML(n)}</span><strong>${money(series[i].at(-1))}</strong></div>`).join('')}</div></div>`;
}
function chartsFor(s){if(s==='New Client')return chart('Growth scenarios',['Downside','Base','Strong upside'],[30,31,32].map(r=>Array.from({length:16},(_,y)=>number(s,'B7')*(1+number(s,'B'+r))**y)),Array.from({length:16},(_,y)=>String(y)),'Years invested · Scenario assumptions, no contributions');if(s==='Retirement Income')return chart('Portfolio through retirement',['Ending portfolio'],[Array.from({length:31},(_,i)=>number(s,'H'+(i+4)))],Array.from({length:31},(_,i)=>String(number(s,'B'+(i+4)))),'Age · Smooth annual returns, inflation-adjusted spending');if(s==='Family Goals')return chart('College fund growth path',['Ending balance'],[Array.from({length:9},(_,i)=>number(s,'K'+(20+i)))],Array.from({length:9},(_,i)=>String(i)),'Years · Risk assumptions reduce over time');if(s==='Jay - Two Goals')return chart('Long-term scenarios',['Downside 2%','Conservative 4%','Base 7%','Upside 10%'],['B','C','D','E'].map(c=>[26,27,28,29].map(r=>number(s,c+r))),['0','5','10','15'],'Workbook scenarios have fixed horizons; risk inputs change allocations, not these return assumptions')+chart('Short-term scenarios',['Severe downside','Downside','Base','Strong upside'],['B','C','D','E'].map(c=>[47,48,49,50].map(r=>number(s,c+r))),['0','1','2','3'],'Years · Losses are possible');if(s==='Growth Projections')return chart('Client growth comparison',['15-year base'],[Array.from({length:6},(_,i)=>number(s,'G'+(15+i)))],Array.from({length:6},(_,i)=>String(value(s,'A'+(15+i)))),'Workbook sample client portfolios');if(s==='Monte Carlo')return `<article><h2>How to read this range</h2><p>This is the workbook’s analytic lognormal range model, not a run of 1,000 random paths. The “simulation paths” input is retained for reference but does not affect these formulas.</p><div class="growth-table">${[4,6,8].map(r=>`<div><small>${escapeHTML(value(s,'F'+r))}</small><strong>${money(number(s,'G'+r))}</strong></div>`).join('')}</div><p>Approximate probability of reaching the target: <b>${percent(number(s,'G1